{
  "expo": {
    "name": "Nelyon",
    "slug": "onspace-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/nelyon/v1/nelyon-app-icon.png",
    "scheme": "onspaceapp",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "ios": {
      "newArchEnabled": true,
      "supportsTablet": true,
      "buildNumber": "22",
      "deploymentTarget": "16.4",
      "bundleIdentifier": "com.clipdag.onspaceapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["fetch", "audio", "voip"],
        "LSApplicationQueriesSchemes": ["metamask", "trust", "cbwallet"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/nelyon/v1/nelyon-adaptive-foreground.png",
        "backgroundColor": "#0C1F4F"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.clipdag.onspaceapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/branding/nelyon/v1/nelyon-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/nelyon/v1/nelyon-wordmark.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FA"
        }
      ],
      "expo-web-browser",
      "./plugins/withDeepARiOS",
      "./plugins/withDeepARFabricView",
      [
        "expo-camera",
        {
          "cameraPermission": "Nelyon necesita la cámara para filtros AR en tiempo real",
          "microphonePermission": "Nelyon necesita el micrófono para grabar videos"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 35
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      ["@stripe/stripe-react-native", {}],
      "expo-asset",
      "expo-audio",
      "expo-font",
      "expo-localization",
      "expo-mail-composer",
      "expo-secure-store",
      "expo-sqlite",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/nelyon/v1/nelyon-notification-icon.png",
          "color": "#1F79FF",
          "mode": "production"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nelyon necesita tu ubicación para mostrarte contenido cercano"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Nelyon necesita acceso a tu galería para subir videos y fotos",
          "savePhotosPermission": "Nelyon necesita acceso para guardar videos en tu galería",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Nelyon usa Face ID para proteger tu cuenta"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Nelyon necesita acceso a tus contactos para que puedas conectar con amigos"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Nelyon necesita acceso al calendario para programar tus publicaciones"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "51815f47-274c-427a-b496-10e1bed06d23"
      }
    }
  }
}
