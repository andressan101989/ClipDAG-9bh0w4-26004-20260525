      "allow_requires_routine_or_absent_law_enforcement_state": true,
      "allow_requires_no_observed_violence": true
    },
    "pointed_brandished_or_fired_weapon": "review",
    "credible_threat_confrontation_or_force": "review",
    "non_graphic_real_violence_or_injury": "review",
    "incidental_blood_or_documentary_violence": "review",
    "ambiguous_or_incomplete": "review",
    "graphic_severe_harm": "block",
    "missing_required_modality": "review",
    "uncertain_age_or_consent": "review"
