        },
        {
          "conname": "live_battle_public_states_projection_version_check",
          "definition": "CHECK ((projection_version >= 1))"
        },
        {
          "conname": "live_battle_public_states_rematch_request_shape_check",
          "definition": "CHECK ((((rematch_request_id IS NULL) AND (rematch_request_after_battle_id IS NULL) AND (rematch_request_status IS NULL) AND (rematch_requested_by_user_id IS NULL) AND (rematch_request_expires_at IS NULL)) OR ((rematch_request_id IS NOT NULL) AND (rematch_request_after_battle_id = battle_id) AND (rematch_request_status IS NOT NULL) AND (rematch_requested_by_user_id IS NOT NULL) AND (rematch_request_expires_at IS NOT NULL))))"
        },
        {
          "conname": "live_battle_public_states_rematch_request_status_check",
          "definition": "CHECK (((rematch_request_status IS NULL) OR (rematch_request_status = ANY (ARRAY['pending'::text, 'accepted'::text, 'rejected'::text, 'expired'::text, 'cancelled'::text]))))"
        },
        {
          "conname": "live_battle_public_states_result_check",
          "definition": "CHECK (((outcome = ANY (ARRAY['pending'::text, 'cancelled'::text])) OR ((outcome = 'challenger'::text) AND (challenger_score > opponent_score)) OR ((outcome = 'opponent'::text) AND (opponent_score > challenger_score)) OR ((outcome = 'tie'::text) AND (challenger_score = opponent_score))))"
        },
        {
          "conname": "live_battle_public_states_score_version_check",
          "definition": "CHECK ((score_version >= 0))"
        },
        {
          "conname": "live_battle_public_states_scores_check",
          "definition": "CHECK (((challenger_score >= 0) AND (opponent_score >= 0)))"
        },
        {
          "conname": "live_battle_public_states_series_counters_check",
          "definition": "CHECK (((series_id IS NULL) OR (((round_number >= 1) AND (round_number <= 5)) AND (series_max_rounds = ANY (ARRAY[1, 5])) AND (series_wins_required = ANY (ARRAY[1, 3])) AND (challenger_series_wins >= 0) AND (opponent_series_wins >= 0) AND (series_ties >= 0) AND (series_rounds_completed >= 0) AND (series_rounds_completed <= series_max_rounds) AND (series_format IS NOT NULL) AND (series_status IS NOT NULL) AND (series_version IS NOT NULL))))"
        },
        {
          "conname": "live_battle_public_states_series_format_check",
          "definition": "CHECK (((series_format IS NULL) OR (series_format = ANY (ARRAY['single'::text, 'best_of_5'::text]))))"
        },
        {
          "conname": "live_battle_public_states_series_status_check",
          "definition": "CHECK (((series_status IS NULL) OR (series_status = ANY (ARRAY['active'::text, 'awaiting_rematch'::text, 'rematch_pending'::text, 'completed'::text, 'cancelled'::text]))))"
        },
        {
          "conname": "live_battle_public_states_session_id_fkey",
          "definition": "FOREIGN KEY (session_id) REFERENCES live_sessions(id) ON DELETE CASCADE"
        },
        {
          "conname": "live_battle_public_states_status_check",
          "definition": "CHECK ((status = ANY (ARRAY['countdown'::text, 'active'::text, 'completed'::text, 'cancelled'::text])))"
        },
        {
          "conname": "live_battle_public_states_terminal_power_check",
          "definition": "CHECK (((status <> ALL (ARRAY['completed'::text, 'cancelled'::text])) OR ((challenger_glove_uses_remaining = 0) AND (opponent_glove_uses_remaining = 0))))"
        },
        {
          "conname": "live_battle_public_states_terminal_timestamp_check",
          "definition": "CHECK ((((status = ANY (ARRAY['countdown'::text, 'active'::text])) AND (ended_at IS NULL)) OR ((status = ANY (ARRAY['completed'::text, 'cancelled'::text])) AND (ended_at IS NOT NULL))))"
        },
        {
          "conname": "live_battle_public_states_v1_power_check",
          "definition": "CHECK (((boost_rule_version <> 1) OR ((rose_target_units = 0) AND (challenger_rose_progress_units = 0) AND (opponent_rose_progress_units = 0) AND (challenger_rose_activations_remaining = 0) AND (opponent_rose_activations_remaining = 0) AND (challenger_glove_uses_remaining = 0) AND (opponent_glove_uses_remaining = 0) AND (challenger_x2_starts_at IS NULL) AND (challenger_x2_expires_at IS NULL) AND (opponent_x2_starts_at IS NULL) AND (opponent_x2_expires_at IS NULL) AND (challenger_x3_starts_at IS NULL) AND (challenger_x3_expires_at IS NULL) AND (opponent_x3_starts_at IS NULL) AND (opponent_x3_expires_at IS NULL))))"
        },
        {
          "conname": "live_battle_public_states_version_check",
          "definition": "CHECK ((version >= 1))"
        },
        {
          "conname": "live_battle_public_states_winner_check",
          "definition": "CHECK ((((outcome = ANY (ARRAY['pending'::text, 'tie'::text, 'cancelled'::text])) AND (winner_user_id IS NULL)) OR ((outcome = ANY (ARRAY['challenger'::text, 'opponent'::text])) AND ((winner_user_id = local_host_user_id) OR (winner_user_id = opponent_host_user_id)))))"
        }
      ],
      "triggers": [
