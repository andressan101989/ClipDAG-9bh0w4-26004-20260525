          "attnotnull": true
        }
      ],
      "constraints": [
        {
          "conname": "live_battle_rule_sets_bounds_check",
          "definition": "CHECK (((rose_target_units >= 0) AND (rose_target_units <= 100000) AND ((rose_duration_seconds >= 0) AND (rose_duration_seconds <= 3600)) AND ((rose_activation_limit_per_side >= 0) AND (rose_activation_limit_per_side <= 100)) AND ((glove_duration_seconds >= 0) AND (glove_duration_seconds <= 3600)) AND ((glove_uses_per_side >= 0) AND (glove_uses_per_side <= 100))))"
        },
        {
          "conname": "live_battle_rule_sets_contract_check",
          "definition": "CHECK ((((glove_acquisition_mode = 'disabled'::text) AND (rose_gift_id IS NULL) AND (rose_target_units = 0) AND (rose_multiplier = 1) AND (rose_duration_seconds = 0) AND (rose_activation_limit_per_side = 0) AND (glove_multiplier = 1) AND (glove_duration_seconds = 0) AND (glove_uses_per_side = 0)) OR ((glove_acquisition_mode = 'fixed_battle_grant'::text) AND (rose_gift_id IS NOT NULL) AND (rose_target_units > 0) AND (rose_multiplier = 2) AND (rose_duration_seconds > 0) AND (rose_activation_limit_per_side = 1) AND (glove_multiplier = 3) AND (glove_duration_seconds > 0) AND (glove_uses_per_side = 1))))"
        },
        {
          "conname": "live_battle_rule_sets_id_version_key",
          "definition": "UNIQUE (id, rule_version)"
        },
        {
          "conname": "live_battle_rule_sets_pkey",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "conname": "live_battle_rule_sets_rose_gift_id_fkey",
          "definition": "FOREIGN KEY (rose_gift_id) REFERENCES gift_catalog(id) ON DELETE RESTRICT"
        },
        {
          "conname": "live_battle_rule_sets_rule_version_key",
          "definition": "UNIQUE (rule_version)"
        },
        {
          "conname": "live_battle_rule_sets_scoring_check",
          "definition": "CHECK ((((gift_points_per_coin >= 1) AND (gift_points_per_coin <= 1000)) AND ((like_points >= 0) AND (like_points <= 1000)) AND ((max_scoreable_likes_per_viewer >= 0) AND (max_scoreable_likes_per_viewer <= 1000)) AND ((like_points = 0) = (max_scoreable_likes_per_viewer = 0))))"
        },
        {
          "conname": "live_battle_rule_sets_version_check",
          "definition": "CHECK ((rule_version > 0))"
        }
      ],
      "triggers": [
        {
          "tgname": "live_battle_rule_sets_immutable",
          "definition": "CREATE TRIGGER live_battle_rule_sets_immutable BEFORE DELETE OR UPDATE ON public.live_battle_rule_sets FOR EACH ROW EXECUTE FUNCTION private.reject_live_battle_rule_set_mutation()"
        }
      ]
    },
