  "tables": [
    {
      "table": "public.live_battle_score_events",
      "columns": [
        {
          "attname": "id",
          "type": "uuid",
          "attnotnull": true
        },
        {
          "attname": "battle_id",
          "type": "uuid",
          "attnotnull": true
        },
        {
          "attname": "gift_transaction_id",
          "type": "uuid",
          "attnotnull": true
        },
        {
          "attname": "target_user_id",
          "type": "uuid",
          "attnotnull": true
        },
        {
          "attname": "base_points",
          "type": "bigint",
          "attnotnull": true
        },
        {
          "attname": "multiplier",
          "type": "integer",
          "attnotnull": true
        },
        {
          "attname": "awarded_points",
          "type": "bigint",
          "attnotnull": true
        },
        {
          "attname": "boost_id",
          "type": "uuid",
          "attnotnull": false
        },
        {
          "attname": "rule_version",
          "type": "integer",
          "attnotnull": true
        },
        {
          "attname": "created_at",
          "type": "timestamp with time zone",
          "attnotnull": true
        }
      ],
      "constraints": [
        {
          "conname": "live_battle_score_events_awarded_points_check",
          "definition": "CHECK ((awarded_points = (base_points * multiplier)))"
        },
        {
          "conname": "live_battle_score_events_base_points_check",
          "definition": "CHECK ((base_points >= 0))"
        },
        {
          "conname": "live_battle_score_events_battle_id_fkey",
          "definition": "FOREIGN KEY (battle_id) REFERENCES live_battles(id) ON DELETE CASCADE"
        },
        {
          "conname": "live_battle_score_events_boost_contract_check",
          "definition": "CHECK ((((multiplier = 1) AND (boost_id IS NULL)) OR ((multiplier = ANY (ARRAY[2, 3])) AND (boost_id IS NOT NULL))))"
        },
        {
          "conname": "live_battle_score_events_boost_fkey",
          "definition": "FOREIGN KEY (boost_id) REFERENCES live_battle_boost_events(id) ON DELETE RESTRICT"
        },
        {
          "conname": "live_battle_score_events_gift_transaction_id_fkey",
          "definition": "FOREIGN KEY (gift_transaction_id) REFERENCES live_gift_transactions(id) ON DELETE RESTRICT"
        },
        {
          "conname": "live_battle_score_events_gift_transaction_id_key",
          "definition": "UNIQUE (gift_transaction_id)"
        },
        {
          "conname": "live_battle_score_events_multiplier_check",
          "definition": "CHECK ((multiplier = ANY (ARRAY[1, 2, 3])))"
        },
        {
          "conname": "live_battle_score_events_pkey",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "conname": "live_battle_score_events_target_user_id_fkey",
          "definition": "FOREIGN KEY (target_user_id) REFERENCES auth.users(id) ON DELETE RESTRICT"
        }
      ],
      "triggers": [
        {
          "tgname": "live_battle_score_events_immutable",
          "definition": "CREATE TRIGGER live_battle_score_events_immutable BEFORE DELETE OR UPDATE ON public.live_battle_score_events FOR EACH ROW EXECUTE FUNCTION private.reject_live_battle_score_event_mutation()"
        }
      ]
    },
    {
      "table": "public.live_battle_score_states",
      "columns": [
        {
          "attname": "battle_id",
          "type": "uuid",
          "attnotnull": true
        },
        {
          "attname": "challenger_score",
          "type": "bigint",
          "attnotnull": true
        },
        {
          "attname": "opponent_score",
          "type": "bigint",
          "attnotnull": true
        },
        {
          "attname": "score_version",
          "type": "bigint",
          "attnotnull": true
        },
        {
          "attname": "outcome",
          "type": "text",
          "attnotnull": true
        },
        {
          "attname": "winner_user_id",
          "type": "uuid",
          "attnotnull": false
        },
        {
          "attname": "finalized_at",
          "type": "timestamp with time zone",
          "attnotnull": false
        },
        {
          "attname": "updated_at",
          "type": "timestamp with time zone",
          "attnotnull": true
        }
      ],
      "constraints": [
        {
          "conname": "live_battle_score_states_battle_id_fkey",
          "definition": "FOREIGN KEY (battle_id) REFERENCES live_battles(id) ON DELETE CASCADE"
        },
        {
          "conname": "live_battle_score_states_finalization_check",
          "definition": "CHECK ((((outcome = 'pending'::text) AND (winner_user_id IS NULL) AND (finalized_at IS NULL)) OR ((outcome = ANY (ARRAY['challenger'::text, 'opponent'::text])) AND (winner_user_id IS NOT NULL) AND (finalized_at IS NOT NULL)) OR ((outcome = ANY (ARRAY['tie'::text, 'cancelled'::text])) AND (winner_user_id IS NULL) AND (finalized_at IS NOT NULL))))"
        },
        {
          "conname": "live_battle_score_states_outcome_check",
          "definition": "CHECK ((outcome = ANY (ARRAY['pending'::text, 'challenger'::text, 'opponent'::text, 'tie'::text, 'cancelled'::text])))"
        },
        {
          "conname": "live_battle_score_states_pkey",
          "definition": "PRIMARY KEY (battle_id)"
        },
        {
          "conname": "live_battle_score_states_result_check",
          "definition": "CHECK (((outcome = ANY (ARRAY['pending'::text, 'cancelled'::text])) OR ((outcome = 'challenger'::text) AND (challenger_score > opponent_score)) OR ((outcome = 'opponent'::text) AND (opponent_score > challenger_score)) OR ((outcome = 'tie'::text) AND (challenger_score = opponent_score))))"
        },
        {
          "conname": "live_battle_score_states_scores_check",
          "definition": "CHECK (((challenger_score >= 0) AND (opponent_score >= 0)))"
        },
        {
          "conname": "live_battle_score_states_version_check",
          "definition": "CHECK ((score_version >= 0))"
        },
        {
          "conname": "live_battle_score_states_winner_user_id_fkey",
          "definition": "FOREIGN KEY (winner_user_id) REFERENCES auth.users(id) ON DELETE RESTRICT"
        }
      ],
      "triggers": [
        {
          "tgname": "live_battle_score_states_rebuild_series",
          "definition": "CREATE TRIGGER live_battle_score_states_rebuild_series AFTER INSERT OR UPDATE ON public.live_battle_score_states FOR EACH ROW EXECUTE FUNCTION private.live_battle_series_score_finalized_trigger()"
        }
      ]
    },
