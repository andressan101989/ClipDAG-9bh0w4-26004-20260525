---
import logo from '../../../../assets/branding/nelyon/v1/nelyon-wordmark-on-dark.png';
import appIcon from '../../../../assets/branding/nelyon/v1/nelyon-app-icon.png';
import { publicCtas } from '../lib/publicCtas';
import { buildArticleStructuredData, buildHomeStructuredData, normalizePublicPath, resolveSeo } from '../lib/seo';
import '../styles/public.css';

type Props = {
  title?: string;
  description?: string;
  indexable?: boolean;
  canonical?: boolean;
  lang?: 'en' | 'es';
  article?: { publishedAt: Date; updatedAt?: Date; image?: string };
};
const { title, description, indexable, canonical: includeCanonical, lang, article } = Astro.props;
const pagePath = normalizePublicPath(Astro.url.pathname);
const isHome = pagePath === '/';
const seo = resolveSeo(pagePath, {
  title,
  description,
  indexable,
  canonical: includeCanonical,
  lang,
  image: article?.image,
  type: article ? 'article' : 'website',
});
const current = (href: string) => pagePath === href ? 'page' : undefined;
const structuredData = article && seo.canonical
  ? buildArticleStructuredData({ headline: seo.title, description: seo.description, canonical: seo.canonical, publishedAt: article.publishedAt, updatedAt: article.updatedAt, image: seo.image })
  : isHome && seo.canonical
    ? buildHomeStructuredData(seo.canonical, new URL(logo.src, Astro.site).toString())
    : null;
const structuredJson = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : null;
---
<!doctype html>
<html lang={seo.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={seo.indexable ? 'index,follow' : 'noindex,nofollow'} />
    <meta name="theme-color" content="#0C1F4F" />
    <meta name="description" content={seo.description} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:site_name" content="Nelyon" />
    <meta property="og:locale" content={seo.lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:title" content={seo.documentTitle} />
    <meta property="og:description" content={seo.description} />
    {seo.canonical && <meta property="og:url" content={seo.canonical} />}
    {seo.image && <meta property="og:image" content={seo.image} />}
    <meta name="twitter:card" content={seo.image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={seo.documentTitle} />
    <meta name="twitter:description" content={seo.description} />
    {seo.image && <meta name="twitter:image" content={seo.image} />}
    {article && <meta property="article:published_time" content={article.publishedAt.toISOString()} />}
    {article?.updatedAt && <meta property="article:modified_time" content={article.updatedAt.toISOString()} />}
    {structuredJson && <script type="application/ld+json" set:html={structuredJson} />}
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    <link rel="icon" href={appIcon.src} type="image/png" />
    <link rel="apple-touch-icon" href={appIcon.src} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{seo.documentTitle}</title>
  </head>
  <body class:list={{ 'home-page': isHome }}>
    <a class="skip-link" href="#main">{seo.lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <header class="site-header" id="site-header">
      <a class="brand" href={publicCtas.home} aria-label="Nelyon, home"><img src={logo.src} width="160" height="42" alt="Nelyon" /></a>
      <nav class="desktop-nav" aria-label="Public navigation">
        <a href={publicCtas.features} aria-current={current(publicCtas.features)}>Features</a><a href={publicCtas.business} aria-current={current(publicCtas.business)}>Business</a><a href={publicCtas.ads} aria-current={current(publicCtas.ads)}>Ads</a>
        <a href={publicCtas.marketplace} aria-current={current(publicCtas.marketplace)}>Marketplace</a><a href={publicCtas.creators} aria-current={current(publicCtas.creators)}>Creators</a><a href={publicCtas.live} aria-current={current(publicCtas.live)}>LIVE</a><a href={publicCtas.whatsNew} aria-current={current(publicCtas.whatsNew)}>What’s New</a>
      </nav>
      <div class="header-actions"><a class="button button-ghost" href={publicCtas.download}>Download</a><a class="button button-primary" href={publicCtas.businessHome}>Open Nelyon Business</a></div>
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="public-mobile-menu" data-menu-toggle><span></span><span></span><span></span></button>
      <nav class="mobile-menu" id="public-mobile-menu" aria-label="Mobile public navigation" hidden>
        <a href={publicCtas.features} aria-current={current(publicCtas.features)}>Features</a><a href={publicCtas.business} aria-current={current(publicCtas.business)}>Business</a><a href={publicCtas.ads} aria-current={current(publicCtas.ads)}>Ads</a>
        <a href={publicCtas.marketplace} aria-current={current(publicCtas.marketplace)}>Marketplace</a><a href={publicCtas.creators} aria-current={current(publicCtas.creators)}>Creators</a><a href={publicCtas.live} aria-current={current(publicCtas.live)}>LIVE</a><a href={publicCtas.whatsNew} aria-current={current(publicCtas.whatsNew)}>What’s New</a>
        <div class="mobile-menu-actions"><a class="button button-ghost" href={publicCtas.download}>Download</a><a class="button button-primary" href={publicCtas.businessHome}>Open Nelyon Business</a></div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand"><img src={logo.src} width="170" height="45" alt="" /><p>Connect. Create. Go LIVE. Grow.</p></div>
      <div class="footer-columns">
        <div><h2>Product</h2><a href={publicCtas.features}>Features</a><a href={publicCtas.marketplace}>Marketplace</a><a href={publicCtas.creators}>Creators</a><a href={publicCtas.live}>LIVE</a><a href={publicCtas.download}>Download</a></div>
        <div><h2>Business</h2><a href={publicCtas.business}>Nelyon Business</a><a href={publicCtas.ads}>Ads</a><a href={publicCtas.businessHome}>Open Nelyon Business</a></div>
        <div><h2>Company</h2><a href={publicCtas.whatsNew}>What’s New</a><a href={publicCtas.support}>Support</a><a href={publicCtas.contact}>Contact</a></div>
        <div><h2>Legal</h2><a href={publicCtas.privacy}>Privacy</a><a href={publicCtas.terms}>Terms</a></div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Nelyon</span><span>One connected ecosystem.</span></div>
    </footer>
    <script>
      const header = document.getElementById('site-header');
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = document.getElementById('public-mobile-menu');
      const setMenu = (open: boolean, restoreFocus = true) => {
        if (!toggle || !menu) return;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        menu.hidden = !open;
        document.body.classList.toggle('menu-open', open);
        if (open) queueMicrotask(() => menu.querySelector<HTMLElement>('a')?.focus());
        else if (restoreFocus) toggle.focus();
      };
      toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false, false)));
      document.addEventListener('keydown', (event) => {
        if (!toggle || !menu || toggle.getAttribute('aria-expanded') !== 'true') return;
        if (event.key === 'Escape') setMenu(false);
        if (event.key === 'Tab') {
          const focusable = [toggle, ...menu.querySelectorAll<HTMLElement>('a, button')];
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
        }
      });
      document.addEventListener('pointerdown', (event) => {
        if (toggle?.getAttribute('aria-expanded') === 'true' && header && !header.contains(event.target as Node)) setMenu(false, false);
      });
      const syncHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
      window.addEventListener('scroll', syncHeader, { passive: true });
      syncHeader();
    </script>
  </body>
</html>
