---
import logo from '../../../../assets/branding/nelyon/v1/nelyon-wordmark-on-dark.png';
import { publicCtas } from '../lib/publicCtas';
import '../styles/public.css';

type Props = { title: string; description: string; article?: { publishedAt: Date; updatedAt?: Date; image?: string } };
const { title, description, article } = Astro.props;
const pagePath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const isHome = pagePath === '/';
const isProductPage = [publicCtas.features, publicCtas.business, publicCtas.ads, publicCtas.marketplace, publicCtas.creators, publicCtas.live].includes(pagePath);
const canonicalPath = pagePath;
const canonical = new URL(canonicalPath, Astro.site).toString();
const isEditorial = pagePath === publicCtas.whatsNew || pagePath.startsWith(`${publicCtas.whatsNew}/`);
const informationRoutes: string[] = [publicCtas.support, publicCtas.contact, publicCtas.privacy, publicCtas.terms];
const isInformationPage = informationRoutes.includes(pagePath);
const articleJson = article ? JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article', headline: title,
  description, datePublished: article.publishedAt.toISOString(),
  ...(article.updatedAt ? { dateModified: article.updatedAt.toISOString() } : {}),
  mainEntityOfPage: canonical, publisher: { '@type': 'Organization', name: 'Nelyon' },
  ...(article.image ? { image: new URL(article.image, Astro.site).toString() } : {}),
}).replace(/</g, '\\u003c') : null;
---
<!doctype html>
<html lang={isHome || isProductPage || isEditorial || isInformationPage || pagePath === publicCtas.download ? 'en' : 'es'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#0C1F4F" />
    <meta name="description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Nelyon" />
    <meta property="og:title" content={isHome ? title : `${title} · Nelyon`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {article?.image && <meta property="og:image" content={new URL(article.image, Astro.site).toString()} />}
    {article && <meta property="article:published_time" content={article.publishedAt.toISOString()} />}
    {article?.updatedAt && <meta property="article:modified_time" content={article.updatedAt.toISOString()} />}
    {articleJson && <script type="application/ld+json" set:html={articleJson} />}
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{isHome ? title : `${title} · Nelyon`}</title>
  </head>
  <body class:list={{ 'home-page': isHome }}>
    <a class="skip-link" href="#main">{isHome || isProductPage || isEditorial || isInformationPage || pagePath === publicCtas.download ? 'Skip to content' : 'Saltar al contenido'}</a>
    <header class="site-header" id="site-header">
      <a class="brand" href={publicCtas.home} aria-label="Nelyon, home"><img src={logo.src} width="160" height="42" alt="Nelyon" /></a>
      <nav class="desktop-nav" aria-label="Public navigation">
        <a href={publicCtas.features}>Features</a><a href={publicCtas.business}>Business</a><a href={publicCtas.ads}>Ads</a>
        <a href={publicCtas.marketplace}>Marketplace</a><a href={publicCtas.creators}>Creators</a><a href={publicCtas.live}>LIVE</a><a href={publicCtas.whatsNew}>What’s New</a>
      </nav>
      <div class="header-actions"><a class="button button-ghost" href={publicCtas.download}>Download</a><a class="button button-primary" href={publicCtas.businessHome}>Open Nelyon Business</a></div>
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="public-mobile-menu" data-menu-toggle><span></span><span></span><span></span></button>
      <nav class="mobile-menu" id="public-mobile-menu" aria-label="Mobile public navigation" hidden>
        <a href={publicCtas.features}>Features</a><a href={publicCtas.business}>Business</a><a href={publicCtas.ads}>Ads</a>
        <a href={publicCtas.marketplace}>Marketplace</a><a href={publicCtas.creators}>Creators</a><a href={publicCtas.live}>LIVE</a><a href={publicCtas.whatsNew}>What’s New</a>
        <div class="mobile-menu-actions"><a class="button button-ghost" href={publicCtas.download}>Download</a><a class="button button-primary" href={publicCtas.businessHome}>Open Nelyon Business</a></div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand"><img src={logo.src} width="170" height="45" alt="Nelyon" /><p>Connect. Create. Go LIVE. Grow.</p></div>
      <div class="footer-columns">
        <div><h2>Product</h2><a href={publicCtas.features}>Features</a><a href={publicCtas.marketplace}>Marketplace</a><a href={publicCtas.creators}>Creators</a><a href={publicCtas.live}>LIVE</a><a href={publicCtas.download}>Download</a></div>
        <div><h2>Business</h2><a href={publicCtas.business}>Nelyon Business</a><a href={publicCtas.ads}>Ads</a><a href={publicCtas.businessHome}>Open Nelyon Business</a></div>
        <div><h2>Company</h2><a href={publicCtas.whatsNew}>What’s New</a><a href={publicCtas.support}>Support</a><a href={publicCtas.contact}>Contact</a></div>
        <div><h2>Legal</h2><a href={publicCtas.privacy}>Privacy</a><a href={publicCtas.terms}>Terms</a></div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Nelyon</span><span>One connected ecosystem.</span></div>
    </footer>
    <script>
      const header = document.getElementById('site-header');
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = document.getElementById('public-mobile-menu');
      const setMenu = (open: boolean) => {
        if (!toggle || !menu) return;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        menu.hidden = !open;
        document.body.classList.toggle('menu-open', open);
        if (!open) toggle.focus();
      };
      toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setMenu(false); });
      const syncHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
      window.addEventListener('scroll', syncHeader, { passive: true });
      syncHeader();
    </script>
  </body>
</html>
