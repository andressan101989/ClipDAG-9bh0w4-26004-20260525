---
import PublicLayout from '../layouts/PublicLayout.astro';
import { legalManifest } from '../../../../shared/legal/manifest.ts';
import { legalDecisions, getApprovedLegalContact } from '../../../../shared/legal/decisions.ts';
import { publicCtas } from '../lib/publicCtas';
import '../styles/help-legal.css';

const contactTypes = [
  { id: 'support', title: 'Support', description: 'Questions about using Nelyon.' },
  { id: 'privacy', title: 'Privacy', description: 'Questions about personal information.' },
  { id: 'legal', title: 'Legal', description: 'Questions about legal documents.' },
] as const;
const contacts = contactTypes.map((item) => ({ ...item, address: getApprovedLegalContact(legalManifest, legalDecisions, item.id) }));
---
<PublicLayout title="Contact Nelyon" description="Check verified Nelyon contact channels and find public guidance while launch details are being finalized.">
  <div class="help-page">
    <section class="help-hero" aria-labelledby="contact-title"><div class="help-container"><span class="help-eyebrow">Nelyon Contact</span><h1 id="contact-title">The right channel, when verified.</h1><p>We only publish official contact details after they are confirmed. This page does not send a message or create a support request.</p></div></section>
    <section class="help-content" aria-label="Contact channels"><div class="help-container">
      <div class="help-contact-grid">
        {contacts.map((item) => <article class="help-card"><h2>{item.title}</h2><p>{item.description}</p>{item.address ? <a class="help-contact-link" href={`mailto:${item.address}`}>{item.address}</a> : <p class="help-unavailable">Official channel not yet published.</p>}</article>)}
      </div>
      <div class="help-contact-note"><h2>Looking for guidance now?</h2><p>The Support Center contains factual topic guides and links to the public product pages. It does not replace a verified contact channel.</p><a class="button button-primary" href={publicCtas.support}>Explore Support</a></div>
    </div></section>
  </div>
</PublicLayout>
