---
type Props = { label: string; title: string; description: string; kind: 'analytics' | 'live' | 'product'; href: string; date: Date; category: string; image?: string };
const { label, title, description, kind, href, date, category, image } = Astro.props;
import { formatUpdateDate } from '../lib/updatePresentation';
---
<a class:list={['update-card', { 'update-card-dark': kind === 'live' }]} href={href}>
  <div class="update-media">{kind === 'analytics' ? <div class="mini-analytics" aria-hidden="true"><span>Business Analytics</span><div><i></i><i></i><i></i><i></i><i></i></div></div> : image ? <img src={image} width="760" height="240" loading="lazy" decoding="async" alt="" /> : <div class="update-media-fallback" aria-hidden="true"></div>}</div>
  <span class="update-label">{category} · {label}</span><h3>{title}</h3><p>{description}</p><time datetime={date.toISOString()}>{formatUpdateDate(date)}</time>
</a>
